{
  "openapi": "3.1.0",
  "info": {
    "title": "lok.computer Public API",
    "version": "3.0.6",
    "description": "Public REST endpoints used by the lok.computer browser desktop. Most operations read public data through an upstream provider. No caller API key is currently required. Upstream-dependent operations can fail independently of the credential-free status endpoint.",
    "contact": {
      "name": "Lok",
      "url": "https://lok.computer/contact",
      "email": "l3on@duck.com"
    },
    "license": {
      "name": "All rights reserved",
      "identifier": "LicenseRef-All-Rights-Reserved"
    }
  },
  "servers": [
    {
      "url": "https://lok.computer",
      "description": "Production"
    }
  ],
  "externalDocs": {
    "description": "lok.computer developer resources",
    "url": "https://lok.computer/developers"
  },
  "security": [],
  "tags": [
    {
      "name": "Discovery",
      "description": "Credential-free API discovery and connectivity checks."
    },
    {
      "name": "AI",
      "description": "Message processing through the server-configured model provider, and typed judgments from the Jev decision model."
    },
    {
      "name": "Social",
      "description": "Read-oriented access to public social data from configured providers."
    },
    {
      "name": "Media",
      "description": "Read-oriented access to Lok's public media shelf."
    }
  ],
  "paths": {
    "/api": {
      "get": {
        "operationId": "getApiDiscovery",
        "summary": "Discover the public API",
        "description": "Returns stable links to the developer documentation, OpenAPI document, and credential-free status endpoint.",
        "tags": ["Discovery"],
        "responses": {
          "200": {
            "description": "API discovery links.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiDiscovery"
                }
              }
            }
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          }
        }
      }
    },
    "/api/status": {
      "get": {
        "operationId": "getApiStatus",
        "summary": "Check API connectivity",
        "description": "Performs a credential-free, side-effect-free check that the lok.computer Worker can respond. It does not probe every upstream provider.",
        "tags": ["Discovery"],
        "responses": {
          "200": {
            "description": "The lok.computer API Worker is reachable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiStatus"
                }
              }
            }
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          }
        }
      }
    },
    "/api/jev/plan": {
      "post": {
        "operationId": "planJevQuestions",
        "summary": "Plan typed Jev questions for a request",
        "description": "Reads a question with the server-configured fast language model, without calling Jev. The reply's `kind` is `plan` (typed Jev questions: a primary question that answers the person plus up to four supporting questions), `needs_input` (fields to ask the person for, then plan again with `inputs`), or `refuse` (Jev cannot judge it, with a suggested rephrasing). Do not send secrets or sensitive personal data.",
        "tags": ["AI"],
        "requestBody": {
          "required": true,
          "description": "What to judge and, optionally, the content to judge.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JevPlanRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A plan, a request for more input, or a refusal.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JevPlanResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "422": {
            "description": "The planner could not produce a valid plan (code `invalid_plan`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "This client exceeded the Ask AI budget of 20 calls per minute.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "$ref": "#/components/responses/UpstreamFailure"
          },
          "503": {
            "description": "The planner model is not configured on this server.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/jev": {
      "post": {
        "operationId": "askJev",
        "summary": "Answer a request with Jev and return the requested properties",
        "description": "Plans a question with the server-configured fast language model (or uses a supplied plan), evaluates it with TypeSafe's Jev decision model, and returns `best` (the answer in plain words with its probability, confidence, and certainty), per-question evidence, notes on close calls and option-order consistency, and the raw Jev request and response. When the planner needs more input or refuses, that reply is returned without calling Jev. Do not send secrets or sensitive personal data.",
        "tags": ["AI"],
        "requestBody": {
          "required": true,
          "description": "A request to plan, or a plan to evaluate as written.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JevAskRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The best answer with analytics, or a needs_input or refuse reply.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/JevAnswer"
                    },
                    {
                      "$ref": "#/components/schemas/JevNeedsInput"
                    },
                    {
                      "$ref": "#/components/schemas/JevRefusal"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "422": {
            "description": "The plan was invalid (code `invalid_plan`) or Jev rejected the questions.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "This client exceeded the Ask AI budget of 20 calls per minute.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "$ref": "#/components/responses/UpstreamFailure"
          },
          "503": {
            "description": "Jev or the planner is not configured, or Jev is temporarily overloaded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/fedi/account": {
      "get": {
        "operationId": "lookupFediverseAccount",
        "summary": "Look up a fediverse account",
        "description": "Looks up a public account by username on the server-configured Mastodon-compatible fediverse instance.",
        "tags": ["Social"],
        "parameters": [
          {
            "name": "username",
            "in": "query",
            "required": true,
            "description": "Account name understood by the configured fediverse instance, without a URL.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The matching public fediverse account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FediverseAccount"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "500": {
            "$ref": "#/components/responses/UpstreamFailure"
          }
        }
      }
    },
    "/api/fedi/statuses": {
      "get": {
        "operationId": "listFediverseStatuses",
        "summary": "List public fediverse statuses",
        "description": "Returns public and unlisted statuses for an account on the configured fediverse instance. Private and direct statuses are filtered out by the Worker.",
        "tags": ["Social"],
        "parameters": [
          {
            "name": "accountId",
            "in": "query",
            "required": true,
            "description": "Provider-specific account identifier returned by the account lookup operation.",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "max_id",
            "in": "query",
            "required": false,
            "description": "Return statuses older than this provider-specific status identifier.",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum number of statuses requested from the upstream instance.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 40,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A list containing only public or unlisted statuses.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FediverseStatus"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "500": {
            "$ref": "#/components/responses/UpstreamFailure"
          }
        }
      }
    },
    "/api/neodb/shelf": {
      "get": {
        "operationId": "listNeoDbShelf",
        "summary": "List items on Lok's NeoDB shelf",
        "description": "Returns one page from a selected section of Lok's public NeoDB media shelf through the server-configured NeoDB integration.",
        "tags": ["Media"],
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "Shelf section to read.",
            "schema": {
              "type": "string",
              "enum": ["wishlist", "progress", "complete", "dropped"],
              "default": "wishlist"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "One-based results page.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "description": "Maximum number of shelf entries requested from NeoDB.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page from the selected public NeoDB shelf.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NeoDbShelfPage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "500": {
            "$ref": "#/components/responses/UpstreamFailure"
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "BadRequest": {
        "description": "The request parameters or JSON body are invalid.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "MethodNotAllowed": {
        "description": "The HTTP method is not supported by this operation.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "The requested upstream resource was not found.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "UpstreamFailure": {
        "description": "The Worker is not configured for the provider or the upstream request failed.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "ApiDiscovery": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description", "documentation", "openapi", "status"],
        "properties": {
          "name": {
            "type": "string",
            "const": "lok.computer public API"
          },
          "description": {
            "type": "string"
          },
          "documentation": {
            "type": "string",
            "format": "uri"
          },
          "openapi": {
            "type": "string",
            "format": "uri"
          },
          "status": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "ApiStatus": {
        "type": "object",
        "additionalProperties": false,
        "required": ["service", "status"],
        "properties": {
          "service": {
            "type": "string",
            "const": "lok.computer public API"
          },
          "status": {
            "type": "string",
            "const": "ok"
          }
        }
      },
      "FediverseAccount": {
        "type": "object",
        "required": ["id", "username", "acct", "url"],
        "properties": {
          "id": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "acct": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "avatar": {
            "type": "string",
            "format": "uri"
          },
          "followers_count": {
            "type": "integer",
            "minimum": 0
          },
          "following_count": {
            "type": "integer",
            "minimum": 0
          },
          "statuses_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "FediverseStatus": {
        "type": "object",
        "required": ["id", "created_at", "content", "visibility", "url", "account"],
        "properties": {
          "id": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "content": {
            "type": "string"
          },
          "visibility": {
            "type": "string",
            "enum": ["public", "unlisted"]
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "account": {
            "$ref": "#/components/schemas/FediverseAccount"
          },
          "media_attachments": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "type", "url"],
              "properties": {
                "id": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "description": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "NeoDbShelfPage": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "pages": {
            "type": "integer",
            "minimum": 0
          },
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["item"],
              "properties": {
                "created_time": {
                  "type": "string",
                  "format": "date-time"
                },
                "rating_grade": {
                  "type": "integer"
                },
                "comment_text": {
                  "type": "string"
                },
                "item": {
                  "type": "object",
                  "required": ["uuid", "title"],
                  "properties": {
                    "uuid": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "display_title": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "cover_image_url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "external_resources": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "string"
          },
          "details": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "description": "Machine-readable reason when available, e.g. invalid_plan."
          }
        }
      },
      "JevPlanRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "A question in plain language. Paste any text it is about into the question, e.g. \"Is this review positive? …\""
          },
          "prompt": {
            "type": "string",
            "maxLength": 2000,
            "deprecated": true,
            "description": "Older name for `question`."
          },
          "inputs": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "maxLength": 8000
            },
            "description": "Answers to the fields of a previous `needs_input` reply, keyed by field key."
          },
          "state": {
            "description": "Content to judge: text, or JSON with descriptive field names.",
            "oneOf": [
              {
                "type": "string",
                "maxLength": 20000
              },
              {
                "type": "object"
              },
              {
                "type": "array"
              }
            ]
          },
          "answerAnyway": {
            "type": "boolean",
            "description": "Plan from what is available instead of asking for more input."
          }
        },
        "description": "Send `question` (or the older `prompt`)."
      },
      "JevAskRequest": {
        "type": "object",
        "additionalProperties": false,
        "description": "A question to plan and answer, or a plan to evaluate as written.",
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "A question in plain language. Paste any text it is about into the question, e.g. \"Is this review positive? …\""
          },
          "prompt": {
            "type": "string",
            "maxLength": 2000,
            "deprecated": true,
            "description": "Older name for `question`."
          },
          "inputs": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "maxLength": 8000
            },
            "description": "Answers to the fields of a previous `needs_input` reply, keyed by field key."
          },
          "state": {
            "description": "Content to judge: text, or JSON with descriptive field names.",
            "oneOf": [
              {
                "type": "string",
                "maxLength": 20000
              },
              {
                "type": "object"
              },
              {
                "type": "array"
              }
            ]
          },
          "answerAnyway": {
            "type": "boolean",
            "description": "Plan from what is available instead of asking for more input."
          },
          "plan": {
            "$ref": "#/components/schemas/JevPlan"
          }
        }
      },
      "JevQuestion": {
        "type": "object",
        "required": ["type", "instructions"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["noul", "choice", "score"]
          },
          "instructions": {
            "description": "The complete question; a string, or an object or array holding the question and data it refers to."
          },
          "criteria": {
            "description": "noul: {true, false} descriptions; choice: option key to description (or null); score: ordered level descriptions, lowest first."
          }
        }
      },
      "JevPlan": {
        "type": "object",
        "required": ["state", "questions"],
        "properties": {
          "summary": {
            "type": "string",
            "description": "What Jev will judge, in one sentence."
          },
          "rationale": {
            "type": ["string", "null"],
            "description": "Why the primary question has its type."
          },
          "state": {
            "description": "Content to judge: text, or JSON with descriptive field names.",
            "oneOf": [
              {
                "type": "string",
                "maxLength": 20000
              },
              {
                "type": "object"
              },
              {
                "type": "array"
              }
            ]
          },
          "primary": {
            "type": "string",
            "description": "Key of the question that answers the person directly. Defaults to the first question."
          },
          "labels": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Short titles by question key."
          },
          "questions": {
            "type": "object",
            "maxProperties": 8,
            "additionalProperties": {
              "$ref": "#/components/schemas/JevQuestion"
            }
          }
        }
      },
      "JevInputField": {
        "type": "object",
        "required": ["key", "label", "placeholder", "multiline", "required"],
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "placeholder": {
            "type": "string"
          },
          "multiline": {
            "type": "boolean"
          },
          "required": {
            "type": "boolean"
          }
        }
      },
      "JevNeedsInput": {
        "type": "object",
        "required": ["kind", "message", "fields", "optional"],
        "description": "The question is about material the person has not given. Ask for the fields, then plan again with `inputs`.",
        "properties": {
          "kind": {
            "const": "needs_input"
          },
          "message": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "$ref": "#/components/schemas/JevInputField"
            }
          },
          "optional": {
            "type": "boolean",
            "description": "Every field is optional; `answerAnyway` is reasonable."
          },
          "planner": {
            "type": ["object", "null"],
            "properties": {
              "model": {
                "type": "string"
              }
            }
          },
          "timing": {
            "type": "object",
            "properties": {
              "plannerMs": {
                "type": ["integer", "null"]
              },
              "jevMs": {
                "type": "integer"
              }
            }
          }
        }
      },
      "JevRefusal": {
        "type": "object",
        "required": ["kind", "message"],
        "description": "Jev cannot judge the question, e.g. a request to write text or do arithmetic.",
        "properties": {
          "kind": {
            "const": "refuse"
          },
          "message": {
            "type": "string"
          },
          "suggestion": {
            "type": ["string", "null"],
            "description": "A rephrased question Jev could answer."
          },
          "planner": {
            "type": ["object", "null"],
            "properties": {
              "model": {
                "type": "string"
              }
            }
          },
          "timing": {
            "type": "object",
            "properties": {
              "plannerMs": {
                "type": ["integer", "null"]
              },
              "jevMs": {
                "type": "integer"
              }
            }
          }
        }
      },
      "JevPlanResponse": {
        "oneOf": [
          {
            "type": "object",
            "required": ["kind", "plan"],
            "properties": {
              "kind": {
                "const": "plan"
              },
              "plan": {
                "$ref": "#/components/schemas/JevPlan"
              },
              "planner": {
                "type": ["object", "null"],
                "properties": {
                  "model": {
                    "type": "string"
                  }
                }
              },
              "timing": {
                "type": "object",
                "properties": {
                  "plannerMs": {
                    "type": ["integer", "null"]
                  },
                  "jevMs": {
                    "type": "integer"
                  }
                }
              }
            }
          },
          {
            "$ref": "#/components/schemas/JevNeedsInput"
          },
          {
            "$ref": "#/components/schemas/JevRefusal"
          }
        ],
        "discriminator": {
          "propertyName": "kind"
        }
      },
      "JevProperty": {
        "type": "object",
        "required": ["type", "title", "question", "primary", "value", "confidence"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["noul", "choice", "score"]
          },
          "title": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "primary": {
            "type": "boolean",
            "description": "This question answers the person directly."
          },
          "value": {
            "description": "noul: boolean; choice: option key; score: position between levels (0 to max)."
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "How decisive the distribution is; for noul, |2p − 1|."
          },
          "probability": {
            "type": "number",
            "description": "noul only: probability of yes."
          },
          "probabilities": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            },
            "description": "choice: by option, highest first; score: by level index."
          },
          "options": {
            "type": "object",
            "description": "choice only: option descriptions."
          },
          "orderCheck": {
            "type": "object",
            "description": "Primary choice only: answers with options as listed and reversed.",
            "properties": {
              "consistent": {
                "type": "boolean"
              },
              "listed": {
                "type": "object"
              },
              "reversed": {
                "type": "object"
              }
            }
          },
          "level": {
            "type": "integer"
          },
          "levelText": {
            "type": "string"
          },
          "max": {
            "type": "integer"
          },
          "scale": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "JevAnswer": {
        "type": "object",
        "required": ["kind", "model", "plan", "best", "result", "properties", "notes", "jev"],
        "properties": {
          "kind": {
            "const": "answer"
          },
          "model": {
            "type": "string",
            "description": "Versioned Jev model that answered, e.g. jev-1.13.0."
          },
          "best": {
            "type": ["object", "null"],
            "description": "The primary question's answer in plain words.",
            "properties": {
              "key": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "question": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": ["noul", "choice", "score"]
              },
              "value": {},
              "answer": {
                "type": "string",
                "description": "e.g. \"Yes\", \"Dwarf planet\", or a score level."
              },
              "detail": {
                "type": ["string", "null"],
                "description": "What the chosen option or yes/no means."
              },
              "probability": {
                "type": "number"
              },
              "confidence": {
                "type": "number"
              },
              "certainty": {
                "type": "string",
                "enum": ["high", "medium", "low"]
              }
            }
          },
          "result": {
            "type": "object",
            "description": "Plain values keyed by question, for code."
          },
          "properties": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/JevProperty"
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "tone": {
                  "type": "string",
                  "enum": ["ok", "info", "warn"]
                },
                "text": {
                  "type": "string"
                }
              }
            }
          },
          "jev": {
            "type": "object",
            "description": "The exact request sent to Jev and its raw response.",
            "properties": {
              "request": {
                "type": "object"
              },
              "response": {
                "type": "object"
              }
            }
          },
          "plan": {
            "$ref": "#/components/schemas/JevPlan"
          },
          "usage": {
            "type": ["object", "null"],
            "properties": {
              "input_tokens": {
                "type": "integer"
              },
              "output_tokens": {
                "type": "integer"
              }
            }
          },
          "planner": {
            "type": ["object", "null"],
            "properties": {
              "model": {
                "type": "string"
              }
            }
          },
          "timing": {
            "type": "object",
            "properties": {
              "plannerMs": {
                "type": ["integer", "null"]
              },
              "jevMs": {
                "type": "integer"
              }
            }
          }
        }
      }
    }
  }
}
