{
  "openapi": "3.1.0",
  "info": {
    "title": "lok.computer Public API",
    "version": "2.0.10",
    "description": "Public REST endpoints used by the lok.computer browser desktop. Most operations read public data through an upstream provider. No caller API key is currently required. Upstream-dependent operations can fail independently of the credential-free status endpoint.",
    "contact": {
      "name": "Lok",
      "url": "https://lok.computer/contact",
      "email": "l3on@duck.com"
    },
    "license": {
      "name": "All rights reserved",
      "identifier": "LicenseRef-All-Rights-Reserved"
    }
  },
  "servers": [
    {
      "url": "https://lok.computer",
      "description": "Production"
    }
  ],
  "externalDocs": {
    "description": "lok.computer developer resources",
    "url": "https://lok.computer/developers"
  },
  "security": [],
  "tags": [
    {
      "name": "Discovery",
      "description": "Credential-free API discovery and connectivity checks."
    },
    {
      "name": "AI",
      "description": "Message processing through the server-configured model provider, and typed judgments from the Jev decision model."
    },
    {
      "name": "Social",
      "description": "Read-oriented access to public social data from configured providers."
    },
    {
      "name": "Media",
      "description": "Read-oriented access to Lok's public media shelf."
    }
  ],
  "paths": {
    "/api": {
      "get": {
        "operationId": "getApiDiscovery",
        "summary": "Discover the public API",
        "description": "Returns stable links to the developer documentation, OpenAPI document, and credential-free status endpoint.",
        "tags": ["Discovery"],
        "responses": {
          "200": {
            "description": "API discovery links.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiDiscovery"
                }
              }
            }
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          }
        }
      }
    },
    "/api/status": {
      "get": {
        "operationId": "getApiStatus",
        "summary": "Check API connectivity",
        "description": "Performs a credential-free, side-effect-free check that the lok.computer Worker can respond. It does not probe every upstream provider.",
        "tags": ["Discovery"],
        "responses": {
          "200": {
            "description": "The lok.computer API Worker is reachable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiStatus"
                }
              }
            }
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "operationId": "createChatCompletion",
        "summary": "Submit a chat conversation",
        "description": "Forwards up to the ten most recent messages, plus the server-configured system instruction when present, to the configured OpenAI-compatible model provider. Do not submit secrets or sensitive personal data.",
        "tags": ["AI"],
        "requestBody": {
          "required": true,
          "description": "A non-empty conversation. The server uses at most the ten most recent messages.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "An OpenAI-compatible chat completion from the configured provider.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatCompletion"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "500": {
            "$ref": "#/components/responses/UpstreamFailure"
          }
        }
      }
    },
    "/api/jev/plan": {
      "post": {
        "operationId": "planJevQuestions",
        "summary": "Plan typed Jev questions for a request",
        "description": "Uses the server-configured fast language model to compile a natural-language request, and optional content, into typed Jev questions (noul, choice, score) without calling Jev. Use it to preview or edit a plan before submitting it to askJev. Do not send secrets or sensitive personal data.",
        "tags": ["AI"],
        "requestBody": {
          "required": true,
          "description": "What to judge and, optionally, the content to judge.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JevPlanRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A validated plan ready for askJev.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JevPlanResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "422": {
            "description": "The planner found nothing to judge (code `refused`) or could not produce a valid plan (code `invalid_plan`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "This client exceeded the Ask AI budget of 20 calls per minute.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "$ref": "#/components/responses/UpstreamFailure"
          },
          "503": {
            "description": "The planner model is not configured on this server.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/jev": {
      "post": {
        "operationId": "askJev",
        "summary": "Answer a request with Jev and return the requested properties",
        "description": "Plans typed questions with the server-configured fast language model (or uses a supplied plan), evaluates them with TypeSafe's Jev decision model, and returns `result`, a JSON object keyed by the requested properties, plus per-property probabilities and confidence. Supplying `plan` skips the planner. Do not send secrets or sensitive personal data.",
        "tags": ["AI"],
        "requestBody": {
          "required": true,
          "description": "A request to plan, or a plan to evaluate as written.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JevAskRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Typed answers formed into the requested properties.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JevAnswer"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "422": {
            "description": "The request or plan was rejected: nothing to judge, an invalid plan, or questions Jev refused.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "This client exceeded the Ask AI budget of 20 calls per minute.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "$ref": "#/components/responses/UpstreamFailure"
          },
          "503": {
            "description": "Jev or the planner is not configured, or Jev is temporarily overloaded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/bsky/feed": {
      "get": {
        "operationId": "listBlueskyFeed",
        "summary": "List Lok's Bluesky feed",
        "description": "Returns a page of public posts and replies from the server-configured Bluesky account. The operation depends on a valid upstream Bluesky session.",
        "tags": ["Social"],
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Opaque cursor returned by a previous page.",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum number of feed entries requested from Bluesky.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of Bluesky feed entries.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BlueskyFeed"
                }
              }
            }
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "500": {
            "$ref": "#/components/responses/UpstreamFailure"
          }
        }
      }
    },
    "/api/fedi/account": {
      "get": {
        "operationId": "lookupFediverseAccount",
        "summary": "Look up a fediverse account",
        "description": "Looks up a public account by username on the server-configured Mastodon-compatible fediverse instance.",
        "tags": ["Social"],
        "parameters": [
          {
            "name": "username",
            "in": "query",
            "required": true,
            "description": "Account name understood by the configured fediverse instance, without a URL.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The matching public fediverse account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FediverseAccount"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "500": {
            "$ref": "#/components/responses/UpstreamFailure"
          }
        }
      }
    },
    "/api/fedi/statuses": {
      "get": {
        "operationId": "listFediverseStatuses",
        "summary": "List public fediverse statuses",
        "description": "Returns public and unlisted statuses for an account on the configured fediverse instance. Private and direct statuses are filtered out by the Worker.",
        "tags": ["Social"],
        "parameters": [
          {
            "name": "accountId",
            "in": "query",
            "required": true,
            "description": "Provider-specific account identifier returned by the account lookup operation.",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "max_id",
            "in": "query",
            "required": false,
            "description": "Return statuses older than this provider-specific status identifier.",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum number of statuses requested from the upstream instance.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 40,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A list containing only public or unlisted statuses.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FediverseStatus"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "500": {
            "$ref": "#/components/responses/UpstreamFailure"
          }
        }
      }
    },
    "/api/neodb/shelf": {
      "get": {
        "operationId": "listNeoDbShelf",
        "summary": "List items on Lok's NeoDB shelf",
        "description": "Returns one page from a selected section of Lok's public NeoDB media shelf through the server-configured NeoDB integration.",
        "tags": ["Media"],
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "Shelf section to read.",
            "schema": {
              "type": "string",
              "enum": ["wishlist", "progress", "complete", "dropped"],
              "default": "wishlist"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "One-based results page.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "description": "Maximum number of shelf entries requested from NeoDB.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page from the selected public NeoDB shelf.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NeoDbShelfPage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "500": {
            "$ref": "#/components/responses/UpstreamFailure"
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "BadRequest": {
        "description": "The request parameters or JSON body are invalid.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "MethodNotAllowed": {
        "description": "The HTTP method is not supported by this operation.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "The requested upstream resource was not found.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "UpstreamFailure": {
        "description": "The Worker is not configured for the provider or the upstream request failed.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "ApiDiscovery": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description", "documentation", "openapi", "status"],
        "properties": {
          "name": {
            "type": "string",
            "const": "lok.computer public API"
          },
          "description": {
            "type": "string"
          },
          "documentation": {
            "type": "string",
            "format": "uri"
          },
          "openapi": {
            "type": "string",
            "format": "uri"
          },
          "status": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "ApiStatus": {
        "type": "object",
        "additionalProperties": false,
        "required": ["service", "status"],
        "properties": {
          "service": {
            "type": "string",
            "const": "lok.computer public API"
          },
          "status": {
            "type": "string",
            "const": "ok"
          }
        }
      },
      "ChatRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["messages"],
        "properties": {
          "messages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            }
          }
        }
      },
      "ChatMessage": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "content"],
        "properties": {
          "role": {
            "type": "string",
            "enum": ["system", "user", "assistant"]
          },
          "content": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "ChatCompletion": {
        "type": "object",
        "required": ["choices"],
        "properties": {
          "id": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["index", "message"],
              "properties": {
                "index": {
                  "type": "integer"
                },
                "message": {
                  "$ref": "#/components/schemas/ChatMessage"
                },
                "finish_reason": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "BlueskyFeed": {
        "type": "object",
        "required": ["feed"],
        "properties": {
          "cursor": {
            "type": "string"
          },
          "feed": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["post"],
              "properties": {
                "post": {
                  "type": "object",
                  "required": ["uri", "cid", "author", "record"],
                  "properties": {
                    "uri": {
                      "type": "string",
                      "format": "uri"
                    },
                    "cid": {
                      "type": "string"
                    },
                    "author": {
                      "$ref": "#/components/schemas/BlueskyProfile"
                    },
                    "record": {
                      "type": "object",
                      "properties": {
                        "text": {
                          "type": "string"
                        },
                        "createdAt": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                },
                "reply": {
                  "type": "object"
                },
                "reason": {
                  "type": "object"
                }
              }
            }
          }
        }
      },
      "BlueskyProfile": {
        "type": "object",
        "required": ["did", "handle"],
        "properties": {
          "did": {
            "type": "string"
          },
          "handle": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "avatar": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "FediverseAccount": {
        "type": "object",
        "required": ["id", "username", "acct", "url"],
        "properties": {
          "id": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "acct": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "avatar": {
            "type": "string",
            "format": "uri"
          },
          "followers_count": {
            "type": "integer",
            "minimum": 0
          },
          "following_count": {
            "type": "integer",
            "minimum": 0
          },
          "statuses_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "FediverseStatus": {
        "type": "object",
        "required": ["id", "created_at", "content", "visibility", "url", "account"],
        "properties": {
          "id": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "content": {
            "type": "string"
          },
          "visibility": {
            "type": "string",
            "enum": ["public", "unlisted"]
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "account": {
            "$ref": "#/components/schemas/FediverseAccount"
          },
          "media_attachments": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "type", "url"],
              "properties": {
                "id": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "description": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "NeoDbShelfPage": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "pages": {
            "type": "integer",
            "minimum": 0
          },
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["item"],
              "properties": {
                "created_time": {
                  "type": "string",
                  "format": "date-time"
                },
                "rating_grade": {
                  "type": "integer"
                },
                "comment_text": {
                  "type": "string"
                },
                "item": {
                  "type": "object",
                  "required": ["uuid", "title"],
                  "properties": {
                    "uuid": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "display_title": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "cover_image_url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "external_resources": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "string"
          },
          "details": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "description": "Machine-readable reason when available, e.g. refused or invalid_plan."
          }
        }
      },
      "JevPlanRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["prompt"],
        "properties": {
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "The properties you want back, in plain language, e.g. \"Is it urgent and which team owns it?\""
          },
          "state": {
            "description": "Content to judge: text, or JSON with descriptive field names.",
            "oneOf": [
              {
                "type": "string",
                "maxLength": 20000
              },
              {
                "type": "object"
              },
              {
                "type": "array"
              }
            ]
          }
        }
      },
      "JevAskRequest": {
        "type": "object",
        "additionalProperties": false,
        "description": "Provide `prompt` (and optional `state`) to plan automatically, or `plan` to evaluate a plan as written.",
        "properties": {
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "The properties you want back, in plain language."
          },
          "state": {
            "description": "Content to judge: text, or JSON with descriptive field names.",
            "oneOf": [
              {
                "type": "string",
                "maxLength": 20000
              },
              {
                "type": "object"
              },
              {
                "type": "array"
              }
            ]
          },
          "plan": {
            "$ref": "#/components/schemas/JevPlan"
          }
        }
      },
      "JevQuestion": {
        "type": "object",
        "required": ["type", "instructions"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["noul", "choice", "score"],
            "description": "noul is yes/no, choice picks one option, score places the state on ordered levels."
          },
          "instructions": {
            "description": "The complete question sent to Jev.",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object"
              },
              {
                "type": "array"
              }
            ]
          },
          "criteria": {
            "description": "Noul: {true, false} descriptions. Choice: option key to description (2-24 options). Score: ordered level descriptions (2-10).",
            "oneOf": [
              {
                "type": "object"
              },
              {
                "type": "array"
              }
            ]
          }
        }
      },
      "JevPlan": {
        "type": "object",
        "required": ["state", "questions"],
        "properties": {
          "summary": {
            "type": "string",
            "description": "One sentence describing what will be judged."
          },
          "state": {
            "description": "Content to judge: text, or JSON with descriptive field names.",
            "oneOf": [
              {
                "type": "string",
                "maxLength": 20000
              },
              {
                "type": "object"
              },
              {
                "type": "array"
              }
            ]
          },
          "questions": {
            "type": "object",
            "description": "One to eight questions keyed by snake_case property name.",
            "additionalProperties": {
              "$ref": "#/components/schemas/JevQuestion"
            }
          }
        }
      },
      "JevPlanResponse": {
        "type": "object",
        "required": ["plan", "timing"],
        "properties": {
          "plan": {
            "$ref": "#/components/schemas/JevPlan"
          },
          "planner": {
            "type": ["object", "null"],
            "properties": {
              "model": {
                "type": "string"
              }
            }
          },
          "timing": {
            "type": "object",
            "properties": {
              "plannerMs": {
                "type": "integer"
              }
            }
          }
        }
      },
      "JevProperty": {
        "type": "object",
        "required": ["type", "question", "value"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["noul", "choice", "score"]
          },
          "question": {
            "type": "string"
          },
          "value": {
            "description": "Boolean for noul (probability >= 0.5), option key for choice, number for score.",
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ]
          },
          "probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Noul only: probability that the answer is yes."
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Choice and score: how peaked the distribution is."
          },
          "probabilities": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          },
          "options": {
            "type": "object",
            "description": "Choice only: option descriptions."
          },
          "level": {
            "type": "integer",
            "description": "Score only: nearest level index."
          },
          "label": {
            "type": "string",
            "description": "Score only: nearest level description."
          },
          "max": {
            "type": "integer",
            "description": "Score only: highest level index."
          },
          "scale": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Score only: level descriptions."
          }
        }
      },
      "JevAnswer": {
        "type": "object",
        "required": ["model", "plan", "result", "properties"],
        "properties": {
          "model": {
            "type": "string",
            "description": "Versioned Jev model that answered, e.g. jev-1.13.0."
          },
          "planner": {
            "type": ["object", "null"],
            "properties": {
              "model": {
                "type": "string"
              }
            }
          },
          "plan": {
            "$ref": "#/components/schemas/JevPlan"
          },
          "result": {
            "type": "object",
            "description": "The requested properties as plain JSON values.",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "string"
                },
                {
                  "type": "number"
                }
              ]
            }
          },
          "properties": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/JevProperty"
            }
          },
          "usage": {
            "type": ["object", "null"],
            "properties": {
              "input_tokens": {
                "type": "integer"
              },
              "output_tokens": {
                "type": "integer"
              }
            }
          },
          "timing": {
            "type": "object",
            "properties": {
              "plannerMs": {
                "type": ["integer", "null"]
              },
              "jevMs": {
                "type": "integer"
              }
            }
          }
        }
      }
    }
  }
}
