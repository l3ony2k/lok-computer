# Deployment settings for a fork of lok.computer.
#
# Frontend (Vite): copy to `.env.local` for local builds, or set them as
# environment variables on the Cloudflare Pages project. Every one is optional;
# an unset value keeps lok.computer's own (src/config/deployment.ts). They are
# compiled into the public site: configuration, not secrets.

# Public origin, no trailing slash. Canonical/social-card URLs and the analytics domain guard.
VITE_SITE_URL=https://example.com
# Umami analytics. Set either one to empty to turn analytics off.
VITE_UMAMI_SRC=
VITE_UMAMI_WEBSITE_ID=
# Accounts the apps show.
VITE_ARENA_USERNAME=
VITE_BSKY_ACTOR=
VITE_FEDI_USERNAME=
VITE_GUESTBOOK_ID=

# Worker (worker/): not read from this file. Plain settings go in
# wrangler.toml [vars] (FEDI_INSTANCE, NEODB_USERNAME, JEV_MODEL,
# JEV_PLANNER_MODEL); secrets with `wrangler secret put` (AI_BASE_URL,
# AI_API_KEY, TYPESAFE_API_KEY, FEDI_ACCESS_TOKEN, NEODB_ACCESS_TOKEN), or in
# `.dev.vars` for `wrangler dev`.
